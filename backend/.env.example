# Provider keys. Each is optional: users can also paste their own keys in the UI
# (sent per request, never stored). Set at least one, or enable the mock provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Keyless offline provider for demos and local development.
ENABLE_MOCK_PROVIDER=true

# Where SQLite metadata and the Chroma vector store are written.
DATA_DIR=data

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

MAX_UPLOAD_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
